// PPFP — personal portfolio data model (PostgreSQL).
// Money: Decimal(24,6). Quantities: Decimal(28,8). Rates/FX: Decimal(20,10).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LotMethod {
  SPECIFIC
  FIFO
  LIFO
  HIFO
  LOFO
  AVERAGE
}

enum AssetType {
  KR_STOCK
  US_STOCK
  CRYPTO
  BOND
  CASH
  REAL_ESTATE
  FUND
  ALTERNATIVE
  LIABILITY
}

/// MANUAL: entered by hand. BROKER: from a linked brokerage API (quotes, or quantities imported from an account).
/// IMPORT: quantities imported from pasted/CSV balances.
enum DataSource {
  MANUAL
  BROKER
  IMPORT
}

/// Brokerages and crypto exchanges with a documented REST OpenAPI for individual accounts.
enum Broker {
  TOSS
  KIS
  KIWOOM
  LS
  DB
  MERITZ
  UPBIT
  BITHUMB
  COINONE
  KORBIT
}

enum TxnType {
  BUY
  SELL
  DEPOSIT
  WITHDRAW
  DIVIDEND
  INTEREST
  FEE
  TAX
  SPLIT
  VALUATION
  /// Loan principal on a one-unit loan holding: + repaid, - drawn (마이너스통장). `price` = balance after.
  /// cashDelta = -principal when paid from the portfolio, else flow = +principal. Snapshots read it like VALUATION.
  REPAY
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  baseCurrency  String    @default("KRW")
  redUp         Boolean   @default(true) // 상승 빨강 / 하락 파랑
  /// Show foreign assets in their own currency (converted at the latest published rate)
  localCurrency Boolean   @default(false)
  createdAt     DateTime  @default(now())
  /// Two-step sign-in (TOTP): the secret encrypted with APP_ENCRYPTION_KEY, set once confirmed
  totpSecret    String?
  /// A secret shown during setup, not yet confirmed with a code
  totpPending   String?
  totpEnabledAt DateTime?
  /// Last 30-second step accepted, so a code cannot be used twice
  totpLastStep  Int?
  /// SHA-256 of the unused recovery codes
  recoveryCodes String[]  @default([])

  sessions         Session[]
  brokers          BrokerConnection[]
  watchlist        WatchItem[]
  portfolios       Portfolio[]
  assets           Asset[]
  auditLogs        AuditLog[]
  journals         JournalEntry[]
  journalTemplates JournalTemplate[]
  journalImages    JournalImage[]
  traitGroups      TraitGroup[]
  priceAlerts      PriceAlert[]
  realEstateAlerts RealEstateAlert[]
  notifications    Notification[]
  pushSubs         PushSubscription[]
  notes            Note[]
  books            Book[]
  sages            Sage[]
  topics           Topic[]
  knowledgeLinks   KnowledgeLink[]
  aiSettings       AiSettings?
  apiKeys          ApiKey[]
  aiSkills         AiSkill[]
  aiConversations  AiConversation[]
  aiMessages       AiMessage[]
  aiActions        AiAction[]
  goals            Goal[]
  loans            Loan[]
  financialProfile FinancialProfile?
  autopilots       AutopilotPolicy[]
  agentDecisions   AgentDecision[]
  tradeOrders      TradeOrder[]
  strategies       Strategy[]
  strategyRuns     StrategyRun[]
  invitesMade      Invite[]           @relation("inviteCreator")
}

model Session {
  id          String    @id // sha256 of the cookie token, never the token itself
  userId      String
  expiresAt   DateTime
  /// Password re-entered; order execution, delegation changes and un-halting are allowed until then
  stepUpUntil DateTime?
  /// Password checked, the two-step code not yet: not signed in until it is
  pendingMfa  Boolean   @default(false)
  userAgent   String?
  ip          String?
  /// Updated at most every 5 minutes
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A user's brokerage OpenAPI link. Secret and cached access token are AES-256-GCM encrypted.
model BrokerConnection {
  id                 String           @id @default(cuid())
  userId             String
  broker             Broker
  label              String
  appKey             String
  secretEncrypted    String
  /// KIS: "12345678-01". Toss: account sequence. Others bind the account to the app key.
  accountNo          String?
  /// Mock-trading environment (KIS, Kiwoom).
  paper              Boolean          @default(false)
  tokenEncrypted     String?
  tokenExpiresAt     DateTime?
  /// Crypto exchanges: portfolio the trade history is replayed into, where it started, and how far it has been synced.
  historyPortfolioId String?
  historySince       DateTime?
  historySyncedTo    DateTime?
  lastSyncAt         DateTime?
  lastError          String?
  /// User turned on ordering for this link (separate from read access)
  tradeEnabled       Boolean          @default(false)
  tradeEnabledAt     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  autopilot          AutopilotPolicy?
  tradeOrders        TradeOrder[]

  @@index([userId])
}

/// A listed stock the user follows on the live market board (it does not need to be held).
model WatchItem {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  name      String
  currency  String
  market    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

model Portfolio {
  id                String    @id @default(cuid())
  userId            String
  name              String
  description       String?
  color             String    @default("#2F4FC9")
  baseCurrency      String    @default("KRW")
  lotMethod         LotMethod @default(FIFO)
  archived          Boolean   @default(false)
  sortOrder         Int       @default(0)
  /// Notify when a target weight is off by more than `driftTolerance` (fraction, 0.05 = 5%p).
  driftAlert        Boolean   @default(false)
  driftTolerance    Decimal   @default(0.05) @db.Decimal(20, 10)
  /// Target keys out of band at the last check, so each breach is told once.
  driftBreaches     String[]  @default([])
  /// Strategy version the advisor checks this portfolio against (advice only, no orders)
  strategyVersionId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentEdges     PortfolioEdge[]   @relation("child")
  childEdges      PortfolioEdge[]   @relation("parent")
  holdings        Holding[]
  cash            CashBalance[]
  transactions    Transaction[]
  snapshots       Snapshot[]
  targets         PortfolioTarget[]
  // NoAction: a followed version cannot be deleted, yet deleting the user still cascades both
  strategyVersion StrategyVersion?  @relation(fields: [strategyVersionId], references: [id], onDelete: NoAction)
  loansPaid       Loan[]            @relation("loanPayFrom")
  autopilot       AutopilotPolicy?

  @@index([userId])
  @@index([strategyVersionId])
}

/// parent contains `allocation` (0 < a <= 1) of child. Cycles and over-allocation are rejected in code.
model PortfolioEdge {
  parentId   String
  childId    String
  allocation Decimal   @db.Decimal(20, 10)
  createdAt  DateTime  @default(now())
  parent     Portfolio @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  child      Portfolio @relation("child", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
  @@index([childId])
}

model Asset {
  id            String     @id @default(cuid())
  userId        String
  type          AssetType
  name          String
  symbol        String? // KRX 6 digits or US ticker, for listed assets
  market        String? // KOSPI, KOSDAQ, NASDAQ ...
  currency      String     @default("KRW")
  priceSource   DataSource @default(MANUAL)
  manualPrice   Decimal?   @db.Decimal(24, 6)
  manualPriceAt DateTime?
  meta          Json? // type specific: coupon, maturity, address, area ...
  /// Sub-kind within `type`, checked per type in code. LIABILITY: MORTGAGE, JEONSE_LOAN, CREDIT,
  /// OVERDRAFT, INSTALLMENT, STUDENT, PRIVATE, LEASE_DEPOSIT_RECEIVED. CASH: TERM_DEPOSIT,
  /// INSTALLMENT_SAVING. ALTERNATIVE: LEASE_DEPOSIT_PAID, RECEIVABLE, VEHICLE, INSURANCE. Null = generic.
  kind          String?
  createdAt     DateTime   @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings         Holding[]
  journals         JournalEntry[]
  traits           AssetTrait[]
  alerts           PriceAlert[]
  realEstateAlerts RealEstateAlert[]
  loan             Loan?             @relation("loanAsset")
  securedLoans     Loan[]            @relation("loanCollateral")
  tradeOrders      TradeOrder[]

  @@unique([userId, symbol])
  @@index([userId])
}

model Holding {
  id          String     @id @default(cuid())
  portfolioId String
  assetId     String
  qtySource   DataSource @default(MANUAL)
  createdAt   DateTime   @default(now())

  portfolio    Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset        Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  lots         Lot[]
  transactions Transaction[]

  @@unique([portfolioId, assetId])
}

model Lot {
  id           String   @id @default(cuid())
  holdingId    String
  acquiredAt   DateTime
  qtyOriginal  Decimal  @db.Decimal(28, 8)
  qtyRemaining Decimal  @db.Decimal(28, 8)
  unitCost     Decimal  @db.Decimal(24, 6) // trade currency, fees included
  fxRate       Decimal  @db.Decimal(20, 10) // base per 1 trade currency
  sourceTxnId  String   @unique
  memo         String?

  holding      Holding          @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  sourceTxn    Transaction      @relation("lotSource", fields: [sourceTxnId], references: [id], onDelete: Cascade)
  consumptions LotConsumption[]

  @@index([holdingId, acquiredAt])
}

model Transaction {
  id            String     @id @default(cuid())
  portfolioId   String
  holdingId     String?
  type          TxnType
  tradeAt       DateTime
  qty           Decimal?   @db.Decimal(28, 8)
  price         Decimal?   @db.Decimal(24, 6)
  fee           Decimal    @default(0) @db.Decimal(24, 6)
  tax           Decimal    @default(0) @db.Decimal(24, 6)
  fxRate        Decimal    @default(1) @db.Decimal(20, 10)
  splitRatio    Decimal?   @db.Decimal(20, 10)
  currency      String
  cashDelta     Decimal    @default(0) @db.Decimal(24, 6)
  flow          Decimal    @default(0) @db.Decimal(24, 6)
  lotMethod     LotMethod?
  memo          String?
  externalRef   String? // e.g. broker order id, for idempotency
  /// Where an imported opening lot came from, e.g. "KIS:12345678-01" or "paste:하나증권".
  importSource  String?
  /// REPAY and its interest/fee rows; they are edited and deleted through the loan
  loanPaymentId String?
  createdAt     DateTime   @default(now())

  portfolio    Portfolio        @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  holding      Holding?         @relation(fields: [holdingId], references: [id], onDelete: SetNull)
  createdLot   Lot?             @relation("lotSource")
  consumptions LotConsumption[]
  journals     JournalTxn[]
  loanPayment  LoanPayment?     @relation(fields: [loanPaymentId], references: [id], onDelete: SetNull)
  orderFill    OrderFill?

  @@unique([portfolioId, externalRef])
  @@index([portfolioId, tradeAt])
  @@index([holdingId])
  @@index([importSource])
  @@index([loanPaymentId])
}

/// How much of which lot a SELL consumed, and the profit realized on it.
model LotConsumption {
  id          String  @id @default(cuid())
  txnId       String
  lotId       String
  qty         Decimal @db.Decimal(28, 8)
  cost        Decimal @db.Decimal(24, 6)
  proceeds    Decimal @db.Decimal(24, 6)
  pnl         Decimal @db.Decimal(24, 6)
  pnlBase     Decimal @db.Decimal(24, 6)
  holdingDays Int

  txn Transaction @relation(fields: [txnId], references: [id], onDelete: Cascade)
  lot Lot         @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([txnId])
}

model CashBalance {
  portfolioId String
  currency    String
  amount      Decimal @db.Decimal(24, 6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@id([portfolioId, currency])
}

/// Daily close per listed symbol (shared across users; market data, not user data).
model PriceDaily {
  symbol   String
  date     DateTime @db.Date
  close    Decimal  @db.Decimal(24, 6)
  currency String
  source   String   @default("BROKER")

  @@id([symbol, date])
}

model FxDaily {
  pair String // e.g. USDKRW
  date DateTime @db.Date
  rate Decimal  @db.Decimal(20, 10)

  @@id([pair, date])
}

/// Value of what a portfolio holds directly, per day, in the user's base currency.
/// Hierarchy roll-ups are computed on read from these rows and the edges.
model Snapshot {
  portfolioId String
  date        DateTime @db.Date
  value       Decimal  @db.Decimal(24, 6)
  flow        Decimal  @db.Decimal(24, 6)
  cash        Decimal  @db.Decimal(24, 6)
  holdings    Json // { [holdingId]: valueBase }
  createdAt   DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@id([portfolioId, date])
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String
  entity   String
  entityId String
  action   String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
}

enum JournalStatus {
  OPEN
  CLOSED
}

/// A trade journal entry about one asset. The target price is required: price alerts and
/// the AI advisor read it, so it is a typed column rather than part of the free-form body.
model JournalEntry {
  id          String        @id @default(cuid())
  userId      String
  assetId     String
  title       String
  /// The day the entry is about (KST date of the trade or the plan).
  entryDate   DateTime      @db.Date
  status      JournalStatus @default(OPEN)
  /// Prices are in `currency`, the asset's trading currency.
  currency    String
  targetPrice Decimal       @db.Decimal(24, 6)
  /// Price when the entry was written; with the target it gives the direction and progress.
  basePrice   Decimal?      @db.Decimal(24, 6)
  stopPrice   Decimal?      @db.Decimal(24, 6)
  targetDate  DateTime?     @db.Date
  /// Template the entry started from: "builtin:<key>" or a JournalTemplate id. Informational only.
  template    String?
  /// Custom properties with their definitions copied in, so later template edits do not change old entries.
  fields      Json          @default("[]")
  /// BlockNote document (array of blocks).
  content     Json          @default("[]")
  /// Plain text of `content`, for search and for the AI advisor.
  contentText String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset  Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  txns   JournalTxn[]
  alerts PriceAlert[]

  @@index([userId, assetId])
  @@index([userId, entryDate])
}

/// Transactions a journal entry is about.
model JournalTxn {
  entryId       String
  transactionId String

  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  transaction Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@id([entryId, transactionId])
  @@index([transactionId])
}

/// A user's own journal format: custom properties plus a starting body.
model JournalTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  fields      Json     @default("[]")
  content     Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Images pasted or uploaded into journal entries. Served only to their owner.
model JournalImage {
  id        String   @id @default(cuid())
  userId    String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A way of classifying assets, e.g. 올웨더 경제 국면 or 주식 스타일. Its traits are the classes.
model TraitGroup {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  /// Built-in preset it was created from ("allWeather", "equityStyle", ...), if any.
  preset      String?
  /// Trait that portfolio cash balances count as in this group's allocation.
  cashTraitId String?
  /// What shares are measured against: "all" (everything held) or "tagged" (only assets tagged in this group).
  base        String   @default("all")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  traits Trait[]

  @@index([userId])
}

/// One class within a group. `targetWeight` is the wanted share of the group (0..1).
model Trait {
  id           String   @id @default(cuid())
  groupId      String
  name         String
  description  String?
  color        String
  targetWeight Decimal? @db.Decimal(20, 10)
  sortOrder    Int      @default(0)

  group  TraitGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assets AssetTrait[]

  @@unique([groupId, name])
}

/// An asset tagged with a trait. An asset with several traits in one group is split evenly between them.
model AssetTrait {
  assetId String
  traitId String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  trait Trait @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@id([assetId, traitId])
  @@index([traitId])
}

enum AlertDirection {
  ABOVE
  BELOW
}

enum AlertSource {
  MANUAL
  JOURNAL_TARGET
  JOURNAL_STOP
}

/// Fires once when the asset's price reaches `price` in `direction`; re-arm it to use again.
/// Journal entries keep one alert per source in sync with their target and stop prices.
model PriceAlert {
  id             String         @id @default(cuid())
  userId         String
  assetId        String
  journalEntryId String?
  source         AlertSource    @default(MANUAL)
  direction      AlertDirection
  /// In the asset's trading currency
  price          Decimal        @db.Decimal(24, 6)
  currency       String
  note           String?
  active         Boolean        @default(true)
  triggeredAt    DateTime?
  triggeredPrice Decimal?       @db.Decimal(24, 6)
  createdAt      DateTime       @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset   Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  journal JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@unique([journalEntryId, source])
  @@index([active])
  @@index([userId])
}

/// Watches an apartment asset's 실거래가: newly reported sales, registrations, cancellations,
/// and the 토지거래허가구역 status of its lot. Checked every few hours; the first check only
/// records what is already there.
model RealEstateAlert {
  id          String    @id @default(cuid())
  userId      String
  assetId     String
  /// TRADE (sale reported), REGISTERED (ownership transfer registered), CANCELLED, ZONE (토지거래허가구역 지정·해제)
  events      String[]
  /// Which sales: AREA (same 전용면적 in the complex), COMPLEX, DONG (the whole 법정동)
  scope       String    @default("AREA")
  /// New sales only within this price range (원)
  minPrice    Decimal?  @db.Decimal(18, 0)
  maxPrice    Decimal?  @db.Decimal(18, 0)
  /// New sales only when above every earlier sale of the same complex and area
  newHighOnly Boolean   @default(false)
  /// ANY, BROKER (중개거래), DIRECT (직거래)
  dealing     String    @default("ANY")
  /// ANY, PERSON (개인), CORP (법인), other buyers (공공기관·기타) only under ANY
  buyer       String    @default("ANY")
  note        String?
  active      Boolean   @default(true)
  /// Sales seen at the last check: key -> flags ("R" registered, "C" cancelled)
  seen        Json?
  /// 토지거래허가구역 at the last check; null before the first check or without a key
  zone        Boolean?
  checkedAt   DateTime?
  lastError   String?
  firedAt     DateTime?
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
}

/// Target weight of one part of a portfolio: a held asset (its id), "CASH", or a child portfolio ("P:<id>").
model PortfolioTarget {
  portfolioId String
  key         String
  weight      Decimal @db.Decimal(20, 10)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@id([portfolioId, key])
}

/// In-app inbox; the same message also goes to the user's push subscriptions.
model Notification {
  id               String    @id @default(cuid())
  userId           String
  kind             String
  title            String
  body             String
  url              String?
  /// AI advisor conversation that analyzed this alert or holds this briefing
  aiConversationId String?
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A browser or phone that accepted Web Push for this user.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  lastError String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Server-wide settings the app creates for itself (Web Push VAPID keys; secrets encrypted).
/// Sign-up invitation; the code itself is shown once and stored as its SHA-256
model Invite {
  id          String    @id
  createdById String
  /// Only this address may use it, when set
  email       String?
  note        String?
  expiresAt   DateTime
  usedAt      DateTime?
  usedBy      String?
  createdAt   DateTime  @default(now())

  createdBy User @relation("inviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
}

model AppSetting {
  key   String @id
  value String
}

/// A quick note. `#키워드` in the body links the note to that topic.
model Note {
  id        String   @id @default(cuid())
  userId    String
  body      String
  pinned    Boolean  @default(false)
  /// Page the note was written on
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

enum BookStatus {
  WANT
  READING
  DONE
}

/// A book and the reader's summary of it.
model Book {
  id            String     @id @default(cuid())
  userId        String
  title         String
  author        String?
  publisher     String?
  publishedYear Int?
  status        BookStatus @default(READING)
  rating        Int?
  startedAt     DateTime?  @db.Date
  finishedAt    DateTime?  @db.Date
  oneLine       String?
  content       Json       @default("[]")
  contentText   String     @default("")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

/// An investor whose philosophy the user keeps notes on.
model Sage {
  id          String   @id @default(cuid())
  userId      String
  name        String
  nameEn      String?
  lived       String?
  affiliation String?
  oneLine     String?
  /// Built-in profile it started from, if any
  preset      String?
  content     Json     @default("[]")
  contentText String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

/// A keyword such as 가치투자 or 안전마진. Linked to traits it implies (가치투자 → 가치주).
model Topic {
  id          String   @id @default(cuid())
  userId      String
  name        String
  color       String   @default("#2a78d6")
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

/// An undirected link between two things the user keeps: note, book, sage, topic, trait, asset.
/// Stored once with the pair in a fixed order (see domain/knowledge.ts).
model KnowledgeLink {
  id        String   @id @default(cuid())
  userId    String
  aType     String
  aId       String
  bType     String
  bId       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, aType, aId, bType, bId])
  @@index([userId, aType, aId])
  @@index([userId, bType, bId])
}

/// A user's key for an outside service other than brokers (AI companies: anthropic, openai,
/// gemini, xai, deepseek; 카카오 책 검색: kakao), AES-256-GCM like
/// broker secrets. `hint` shows the last characters. Without one, the server's env key is used.
model ApiKey {
  userId    String
  service   String
  keyEnc    String
  hint      String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, service])
}

/// AI advisor settings: which model each agent uses (`{ MANAGER: { provider, model }, … }`),
/// a monthly spending cap, and what runs by itself. API keys for each AI company are in ApiKey.
model AiSettings {
  userId            String    @id
  agentModels       Json      @default("{}")
  /// Monthly cap in USD, estimated from token usage; null = no cap
  monthlyLimit      Decimal?  @db.Decimal(10, 2)
  webSearch         Boolean   @default(true)
  /// Morning briefing: on/off, hour (KST), weekdays only, and the KST date of the last one sent
  briefing          Boolean   @default(false)
  briefingHour      Int       @default(8)
  briefingWeekdays  Boolean   @default(true)
  briefingLastDate  String?
  /// Have the advisor look into each price / target-weight alert as it arrives
  alertAnalysis     Boolean   @default(false)
  /// Global kill switch: no order of any policy is sent while set
  tradingHaltedAt   DateTime?
  tradingHaltReason String?
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A skill an advisor agent reads when a question fits (Agent Skills SKILL.md format): written by
/// the user or imported from a community catalog. Only text is kept; scripts are never run.
model AiSkill {
  id           String   @id @default(cuid())
  userId       String
  /// SKILL.md name: lowercase letters, digits and hyphens, unique per user
  name         String
  /// When to use it; the agent sees this before reading the instructions
  description  String
  instructions String
  /// Other markdown files from the skill's folder: [{ path, content }]
  resources    Json     @default("[]")
  /// Agents that use it (AgentKind)
  agents       String[]
  enabled      Boolean  @default(true)
  /// custom, or skills.sh for a community skill
  source       String   @default("custom")
  /// skills.sh id (owner/repo/skill), the SKILL.md path in that repository, and its GitHub page
  sourceId     String?
  sourcePath   String?
  sourceUrl    String?
  license      String?
  /// Installs on skills.sh when it was imported
  installs     Int?
  /// Files of the original folder that were left out (scripts and the like)
  skipped      Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

/// One chat with an advisor agent. `agent` is MANAGER (포트폴리오 매니저) or SAGE (an investor's lens, sageId).
model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  agent     String
  sageId    String?
  /// The AI company and model the conversation runs on, fixed when it starts (null = Claude, the default model)
  provider  String?
  model     String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  actions   AiAction[]
  decisions AgentDecision[]

  @@index([userId, updatedAt])
}

/// A message exactly as sent to or received from the Messages API, in order (append-only).
model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  seq            Int
  role           String
  content        Json
  model          String?
  usage          Json?
  costUsd        Decimal  @default(0) @db.Decimal(12, 6)
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@index([userId, createdAt])
}

/// Something an agent proposed that changes data (a memo, a price alert, target weights).
/// Runs only when the user presses 실행.
model AiAction {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  toolUseId      String
  kind           String
  payload        Json
  summary        String
  /// PENDING, DONE, DISMISSED, FAILED
  status         String   @default("PENDING")
  result         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeOrder   TradeOrder?

  @@index([conversationId])
}

/// A money goal (은퇴 자금, 주택 등): reach `target` by `targetDate` from a portfolio's value
/// (null = net worth) plus monthly saving. Return and volatility override the mix-based assumptions.
model Goal {
  id             String   @id @default(cuid())
  userId         String
  name           String
  target         Decimal  @db.Decimal(24, 2)
  targetDate     DateTime @db.Date
  monthly        Decimal  @default(0) @db.Decimal(24, 2)
  portfolioId    String?
  expectedReturn Decimal? @db.Decimal(8, 5)
  volatility     Decimal? @db.Decimal(8, 5)
  /// Show and compare in today's money (2.5% a year)
  realTerms      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Calls to outside services per day, for the usage page. userId is "" for calls not tied to a user (broker market data).
model ApiUsage {
  userId  String
  /// "anthropic", "openai", "kakao-book", "github", "broker:KIS" ...
  service String
  /// KST date
  day     DateTime @db.Date
  calls   Int      @default(0)
  errors  Int      @default(0)
  /// Refused for going over a rate limit or quota (HTTP 429 and the like)
  limited Int      @default(0)
  lastAt  DateTime @default(now())

  @@id([userId, service, day])
  @@index([userId, day])
}

/// The latest rate-limit headers a service sent back (requests/tokens left and when they reset).
model ApiLimit {
  userId  String
  service String
  headers Json
  at      DateTime @default(now())

  @@id([userId, service])
}

// ── Net worth: loans ─────────────────────────────────────────────

enum RepaymentMethod {
  AMORTIZING // 원리금균등
  EQUAL_PRINCIPAL // 원금균등
  BULLET // 만기일시
  REVOLVING // 마이너스통장: daily interest on the drawn balance
  CUSTOM // 사인 간 등: no schedule, payments only
}

/// Terms of a loan. The asset (LIABILITY, or ALTERNATIVE/RECEIVABLE when `lent`) sits in exactly one
/// holding with one unit; its ledger carries the balance. Rates live only in LoanRate.
model Loan {
  id              String          @id @default(cuid())
  userId          String
  assetId         String          @unique
  /// Money lent out (대여금) rather than borrowed
  lent            Boolean         @default(false)
  lender          String?
  /// 사인 간 상대방; always masked before reaching the AI
  counterparty    String?
  principal       Decimal         @db.Decimal(24, 6)
  /// REVOLVING: 한도
  creditLimit     Decimal?        @db.Decimal(24, 6)
  startDate       DateTime        @db.Date
  /// Null for CUSTOM or open-ended REVOLVING
  maturityDate    DateTime?       @db.Date
  method          RepaymentMethod
  graceMonths     Int             @default(0)
  /// Day of month due (past month end = last day)
  paymentDay      Int             @default(1)
  /// FIXED, VARIABLE, MIXED: only tells the UI to ask for a new rate at resets
  rateType        String          @default("FIXED")
  /// Next 금리 재산정, for reminders
  nextResetAt     DateTime?       @db.Date
  /// 중도상환수수료 on the prepaid amount, sliding to 0 over `prepayFeeMonths` (0 = none)
  prepayFeeRate   Decimal         @default(0) @db.Decimal(20, 10)
  prepayFeeMonths Int             @default(0)
  collateralId    String?
  /// Portfolio whose cash pays installments; null = paid outside the app (interest stays off the ledger)
  payFromId       String?
  note            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset      Asset         @relation("loanAsset", fields: [assetId], references: [id], onDelete: Cascade)
  collateral Asset?        @relation("loanCollateral", fields: [collateralId], references: [id], onDelete: SetNull)
  payFrom    Portfolio?    @relation("loanPayFrom", fields: [payFromId], references: [id], onDelete: SetNull)
  rates      LoanRate[]
  payments   LoanPayment[]

  @@index([userId])
  @@index([collateralId])
}

/// Annual rate in force from `from` (first row = rate at start; later rows = resets, 금리인하요구).
model LoanRate {
  loanId String
  from   DateTime @db.Date
  rate   Decimal  @db.Decimal(20, 10)

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@id([loanId, from])
}

/// A payment or draw actually made. Ledger rows point back via Transaction.loanPaymentId.
model LoanPayment {
  id           String    @id @default(cuid())
  loanId       String
  /// Installment it settles; null = prepayment or REVOLVING movement (NULLs never collide in the unique)
  dueDate      DateTime? @db.Date
  paidAt       DateTime
  /// + repaid, - drawn
  principal    Decimal   @db.Decimal(24, 6)
  interest     Decimal   @default(0) @db.Decimal(24, 6)
  fee          Decimal   @default(0) @db.Decimal(24, 6)
  balanceAfter Decimal   @db.Decimal(24, 6)
  prepayment   Boolean   @default(false)
  memo         String?
  createdAt    DateTime  @default(now())

  loan Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  txns Transaction[]

  @@unique([loanId, dueDate])
  @@index([loanId, paidAt])
}

/// What the balance-sheet ratios and the advisor need that the ledger does not hold.
model FinancialProfile {
  userId          String   @id
  annualIncome    Decimal? @db.Decimal(24, 6)
  birthYear       Int?
  retireAge       Int?
  /// CAPITAL or OTHER; null hides stress DSR
  region          String?
  emergencyMonths Int      @default(6)
  /// Send income and loan terms to the AI (counterparties stay masked)
  shareWithAi     Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Autopilot: delegated trading ─────────────────────────────────

/// Delegation steps. Compare in code with an explicit rank (Prisma enums have no ordering).
enum DelegationLevel {
  SUGGEST // draft order cards only, no execute button
  APPROVE // every order needs the user's confirmation
  AUTO // within limits without confirmation (PAPER first)
}

enum TradeMode {
  PAPER
  LIVE
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING_APPROVAL
  BLOCKED // failed the pre-trade check, never sent
  DISMISSED
  EXPIRED
  SUBMITTING // claimed and being sent; older than a minute becomes UNKNOWN
  SUBMITTED
  PARTIAL
  FILLED
  CANCELLED
  REJECTED // refused by the broker
  /// Sent but the answer was lost; resolved from the broker's order list before any new order on the symbol
  UNKNOWN
}

/// Trading policy for one portfolio (and at most one account). Every order runs inside it.
/// Changes bump `version` and go to AuditLog.
model AutopilotPolicy {
  id             String          @id @default(cuid())
  userId         String
  name           String
  /// Account orders go to; null = paper only. One policy per account.
  connectionId   String?         @unique
  /// Portfolio fills are recorded into; must hold only this account's lots. One policy per portfolio.
  portfolioId    String          @unique
  level          DelegationLevel @default(SUGGEST)
  mode           TradeMode       @default(PAPER)
  objective      String          @default("")
  allowedTypes   AssetType[]     @default([KR_STOCK])
  /// Symbols the advisor may trade (required for AUTO) and never trades
  allowSymbols   String[]        @default([])
  denySymbols    String[]        @default([])
  /// Limits in KRW
  maxOrder       Decimal         @db.Decimal(24, 6)
  maxDaily       Decimal         @db.Decimal(24, 6)
  maxDailyOrders Int             @default(5)
  /// Fractions (0.02 = 2%)
  dailyLossStop  Decimal         @default(0.02) @db.Decimal(20, 10)
  maxPriceGap    Decimal         @default(0.03) @db.Decimal(20, 10)
  /// Paper account: starting cash and slippage for simulated fills
  paperCash      Decimal         @default(10000000) @db.Decimal(24, 6)
  slippageBp     Int             @default(10)
  version        Int             @default(1)
  haltedAt       DateTime?
  haltReason     String?
  /// Claimed by a server process before running an AUTO cycle, like AiSettings.briefingLastDate
  cycleClaimedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction: deleting the user still cascades; deleting just the portfolio is refused while a policy exists
  portfolio  Portfolio         @relation(fields: [portfolioId], references: [id], onDelete: NoAction)
  connection BrokerConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  orders     TradeOrder[]
  decisions  AgentDecision[]

  @@index([userId])
}

/// One advisor proposal or cycle that may lead to orders. Rationale is copied; inputs stay in the conversation.
model AgentDecision {
  id             String   @id @default(cuid())
  userId         String
  policyId       String
  policyVersion  Int
  /// USER (chat), SCHEDULE, DRIFT, ALERT
  trigger        String
  conversationId String?
  /// NO_TRADE, ORDERS, BLOCKED, ERROR
  outcome        String
  rationale      String   @default("")
  counterpoints  String   @default("")
  /// The conversation read outside text; its orders always wait for approval
  tainted        Boolean  @default(false)
  /// web_search, web_fetch, search_books, skill:<name>
  taintSources   String[] @default([])
  /// Model that actually answered (a server-side fallback may differ from the setting)
  model          String?
  costUsd        Decimal  @default(0) @db.Decimal(12, 6)
  createdAt      DateTime @default(now())

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy       AutopilotPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  orders       TradeOrder[]

  @@index([policyId, createdAt])
  @@index([userId, createdAt])
}

/// An order, paper or live, from proposal to its last fill.
model TradeOrder {
  id            String      @id @default(cuid())
  userId        String
  policyId      String
  decisionId    String?
  /// Chat card the order came from
  aiActionId    String?     @unique
  connectionId  String?
  mode          TradeMode
  assetId       String?
  symbol        String
  /// KRX for now
  exchange      String      @default("KRX")
  currency      String      @default("KRW")
  side          OrderSide
  /// LIMIT only for now
  orderType     String      @default("LIMIT")
  qty           Decimal     @db.Decimal(28, 8)
  limitPrice    Decimal?    @db.Decimal(24, 6)
  /// Amount held against the policy's limits while the order is open
  reserved      Decimal     @default(0) @db.Decimal(24, 6)
  /// Ours; sent as the broker's identifier where supported. Never reused.
  clientOrderId String      @unique
  brokerOrderId String?
  status        OrderStatus @default(PENDING_APPROVAL)
  /// Pre-trade results [{ rule, ok, level, message }]
  checks        Json        @default("[]")
  filledQty     Decimal     @default(0) @db.Decimal(28, 8)
  avgFillPrice  Decimal?    @db.Decimal(24, 6)
  error         String?
  expiresAt     DateTime?
  approvedAt    DateTime?
  submittedAt   DateTime?
  lastCheckedAt DateTime?
  closedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy     AutopilotPolicy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  decision   AgentDecision?    @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  aiAction   AiAction?         @relation(fields: [aiActionId], references: [id], onDelete: SetNull)
  connection BrokerConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  asset      Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  fills      OrderFill[]

  @@unique([connectionId, brokerOrderId])
  @@index([status, updatedAt]) // poller
  @@index([policyId, createdAt])
  @@index([userId, createdAt])
}

/// One increase of an order's filled quantity. Live stock fills go to the ledger once
/// (Transaction.externalRef "<BROKER>:ord:<brokerOrderId>:<seq>"); paper fills never touch it.
model OrderFill {
  id            String   @id @default(cuid())
  orderId       String
  seq           Int
  brokerFillId  String?
  qty           Decimal  @db.Decimal(28, 8)
  price         Decimal  @db.Decimal(24, 6)
  fee           Decimal  @default(0) @db.Decimal(24, 6)
  tax           Decimal  @default(0) @db.Decimal(24, 6)
  /// Fee and tax were estimated and still need the broker's figures
  estimated     Boolean  @default(false)
  filledAt      DateTime
  transactionId String?  @unique
  createdAt     DateTime @default(now())

  order       TradeOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([orderId, seq])
}

// ── Strategies: investment philosophy as testable rules ─────────

/// A strategy the advisor checks a portfolio against and the app can test: principles in prose
/// plus closed-schema rules. Every edit adds a StrategyVersion.
model Strategy {
  id            String   @id @default(cuid())
  userId        String
  name          String
  oneLine       String?
  /// custom, template:<key>, skill (drafted from an AiSkill), sage (drafted from a Sage)
  origin        String   @default("custom")
  /// What it was drafted from; plain ids, the skill or sage may be deleted later
  skillId       String?
  sageId        String?
  /// Version number the user adopted; null until one is (drafts wait here)
  activeVersion Int?
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions StrategyVersion[]

  @@unique([userId, name])
}

/// One immutable revision. Runs and portfolios pin a version, never the strategy.
model StrategyVersion {
  id          String   @id @default(cuid())
  strategyId  String
  version     Int
  /// Principles in markdown; shown to agents only inside an untrusted-text block
  principles  String   @default("")
  /// StrategyRules { schemaVersion, assets, cashWeight, rebalance, band, limits } (zod, closed)
  rules       Json
  /// sha256 of principles + rules
  contentHash String
  /// Text-lint findings from a skill or sage conversion: [{ level, code, excerpt }]
  lint        Json     @default("[]")
  /// user, ai (strategy_draft action), template
  author      String   @default("user")
  note        String?
  createdAt   DateTime @default(now())

  strategy   Strategy      @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  runs       StrategyRun[]
  portfolios Portfolio[]

  @@unique([strategyId, version])
}

/// A test of a pinned version: BACKTEST over past closes or PAPER forward from startDate.
/// Values are replayed from PriceDaily on read; only the summary is cached in `metrics`.
model StrategyRun {
  id         String    @id @default(cuid())
  userId     String
  versionId  String
  /// BACKTEST or PAPER
  mode       String
  startDate  DateTime  @db.Date
  /// End of a BACKTEST; null for PAPER (runs to the latest close)
  endDate    DateTime? @db.Date
  /// Benchmark symbol (performance.ts BENCHMARKS)
  benchmark  String    @default("069500")
  /// Per trade side, and sell-side tax, in basis points
  feeBps     Decimal   @default(15) @db.Decimal(8, 2)
  taxBps     Decimal   @default(0) @db.Decimal(8, 2)
  /// Last metrics, warnings, coverage and a hash of the input closes
  metrics    Json      @default("{}")
  computedAt DateTime?
  lastError  String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  version StrategyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([versionId])
}
