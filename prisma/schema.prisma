// PPFP — personal portfolio data model (PostgreSQL).
// Money: Decimal(24,6). Quantities: Decimal(28,8). Rates/FX: Decimal(20,10).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LotMethod {
  SPECIFIC
  FIFO
  LIFO
  HIFO
  LOFO
  AVERAGE
}

enum AssetType {
  KR_STOCK
  US_STOCK
  CRYPTO
  BOND
  CASH
  REAL_ESTATE
  FUND
  ALTERNATIVE
  LIABILITY
}

/// MANUAL: entered by hand. BROKER: from a linked brokerage API (quotes, or quantities imported from an account).
/// IMPORT: quantities imported from pasted/CSV balances.
enum DataSource {
  MANUAL
  BROKER
  IMPORT
}

/// Brokerages and crypto exchanges with a documented REST OpenAPI for individual accounts.
enum Broker {
  TOSS
  KIS
  KIWOOM
  LS
  DB
  MERITZ
  UPBIT
  BITHUMB
  COINONE
  KORBIT
}

enum TxnType {
  BUY
  SELL
  DEPOSIT
  WITHDRAW
  DIVIDEND
  INTEREST
  FEE
  TAX
  SPLIT
  VALUATION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  baseCurrency String   @default("KRW")
  redUp        Boolean  @default(true) // 상승 빨강 / 하락 파랑
  createdAt    DateTime @default(now())

  sessions        Session[]
  brokers         BrokerConnection[]
  watchlist       WatchItem[]
  portfolios      Portfolio[]
  assets          Asset[]
  auditLogs       AuditLog[]
  journals         JournalEntry[]
  journalTemplates JournalTemplate[]
  journalImages    JournalImage[]
  traitGroups      TraitGroup[]
  priceAlerts      PriceAlert[]
  notifications    Notification[]
  pushSubs         PushSubscription[]
  notes            Note[]
  books            Book[]
  sages            Sage[]
  topics           Topic[]
  knowledgeLinks   KnowledgeLink[]
  aiSettings       AiSettings?
  apiKeys          ApiKey[]
  aiConversations  AiConversation[]
  aiMessages       AiMessage[]
  aiActions        AiAction[]
  goals            Goal[]
}

model Session {
  id        String   @id // sha256 of the cookie token, never the token itself
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A user's brokerage OpenAPI link. Secret and cached access token are AES-256-GCM encrypted.
model BrokerConnection {
  id              String    @id @default(cuid())
  userId          String
  broker          Broker
  label           String
  appKey          String
  secretEncrypted String
  /// KIS: "12345678-01". Toss: account sequence. Others bind the account to the app key.
  accountNo       String?
  /// Mock-trading environment (KIS, Kiwoom).
  paper           Boolean   @default(false)
  tokenEncrypted  String?
  tokenExpiresAt  DateTime?
  /// Crypto exchanges: portfolio the trade history is replayed into, where it started, and how far it has been synced.
  historyPortfolioId String?
  historySince       DateTime?
  historySyncedTo    DateTime?
  lastSyncAt      DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A listed stock the user follows on the live market board (it does not need to be held).
model WatchItem {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  name      String
  currency  String
  market    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

model Portfolio {
  id           String    @id @default(cuid())
  userId       String
  name         String
  description  String?
  color        String    @default("#2F4FC9")
  baseCurrency String    @default("KRW")
  lotMethod    LotMethod @default(FIFO)
  archived     Boolean   @default(false)
  sortOrder    Int       @default(0)
  /// Notify when a target weight is off by more than `driftTolerance` (fraction, 0.05 = 5%p).
  driftAlert     Boolean  @default(false)
  driftTolerance Decimal  @default(0.05) @db.Decimal(20, 10)
  /// Target keys out of band at the last check, so each breach is told once.
  driftBreaches  String[] @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentEdges  PortfolioEdge[] @relation("child")
  childEdges   PortfolioEdge[] @relation("parent")
  holdings     Holding[]
  cash         CashBalance[]
  transactions Transaction[]
  snapshots    Snapshot[]
  targets      PortfolioTarget[]

  @@index([userId])
}

/// parent contains `allocation` (0 < a <= 1) of child. Cycles and over-allocation are rejected in code.
model PortfolioEdge {
  parentId   String
  childId    String
  allocation Decimal  @db.Decimal(20, 10)
  createdAt  DateTime @default(now())
  parent     Portfolio @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  child      Portfolio @relation("child", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
  @@index([childId])
}

model Asset {
  id          String     @id @default(cuid())
  userId      String
  type        AssetType
  name        String
  symbol      String?    // KRX 6 digits or US ticker, for listed assets
  market      String?    // KOSPI, KOSDAQ, NASDAQ ...
  currency    String     @default("KRW")
  priceSource DataSource @default(MANUAL)
  manualPrice Decimal?   @db.Decimal(24, 6)
  manualPriceAt DateTime?
  meta        Json?      // type specific: coupon, maturity, address, area ...
  createdAt   DateTime   @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings Holding[]
  journals JournalEntry[]
  traits   AssetTrait[]
  alerts   PriceAlert[]

  @@unique([userId, symbol])
  @@index([userId])
}

model Holding {
  id          String     @id @default(cuid())
  portfolioId String
  assetId     String
  qtySource   DataSource @default(MANUAL)
  createdAt   DateTime   @default(now())

  portfolio    Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset        Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  lots         Lot[]
  transactions Transaction[]

  @@unique([portfolioId, assetId])
}

model Lot {
  id           String   @id @default(cuid())
  holdingId    String
  acquiredAt   DateTime
  qtyOriginal  Decimal  @db.Decimal(28, 8)
  qtyRemaining Decimal  @db.Decimal(28, 8)
  unitCost     Decimal  @db.Decimal(24, 6) // trade currency, fees included
  fxRate       Decimal  @db.Decimal(20, 10) // base per 1 trade currency
  sourceTxnId  String   @unique
  memo         String?

  holding      Holding          @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  sourceTxn    Transaction      @relation("lotSource", fields: [sourceTxnId], references: [id], onDelete: Cascade)
  consumptions LotConsumption[]

  @@index([holdingId, acquiredAt])
}

model Transaction {
  id          String    @id @default(cuid())
  portfolioId String
  holdingId   String?
  type        TxnType
  tradeAt     DateTime
  qty         Decimal?  @db.Decimal(28, 8)
  price       Decimal?  @db.Decimal(24, 6)
  fee         Decimal   @default(0) @db.Decimal(24, 6)
  tax         Decimal   @default(0) @db.Decimal(24, 6)
  fxRate      Decimal   @default(1) @db.Decimal(20, 10)
  splitRatio  Decimal?  @db.Decimal(20, 10)
  currency    String
  cashDelta   Decimal   @default(0) @db.Decimal(24, 6)
  flow        Decimal   @default(0) @db.Decimal(24, 6)
  lotMethod   LotMethod?
  memo        String?
  externalRef String?   // e.g. broker order id, for idempotency
  /// Where an imported opening lot came from, e.g. "KIS:12345678-01" or "paste:하나증권".
  importSource String?
  createdAt   DateTime  @default(now())

  portfolio    Portfolio        @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  holding      Holding?         @relation(fields: [holdingId], references: [id], onDelete: SetNull)
  createdLot   Lot?             @relation("lotSource")
  consumptions LotConsumption[]
  journals     JournalTxn[]

  @@unique([portfolioId, externalRef])
  @@index([portfolioId, tradeAt])
  @@index([holdingId])
  @@index([importSource])
}

/// How much of which lot a SELL consumed, and the profit realized on it.
model LotConsumption {
  id          String   @id @default(cuid())
  txnId       String
  lotId       String
  qty         Decimal  @db.Decimal(28, 8)
  cost        Decimal  @db.Decimal(24, 6)
  proceeds    Decimal  @db.Decimal(24, 6)
  pnl         Decimal  @db.Decimal(24, 6)
  pnlBase     Decimal  @db.Decimal(24, 6)
  holdingDays Int

  txn Transaction @relation(fields: [txnId], references: [id], onDelete: Cascade)
  lot Lot         @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([txnId])
}

model CashBalance {
  portfolioId String
  currency    String
  amount      Decimal @db.Decimal(24, 6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@id([portfolioId, currency])
}

/// Daily close per listed symbol (shared across users; market data, not user data).
model PriceDaily {
  symbol   String
  date     DateTime @db.Date
  close    Decimal  @db.Decimal(24, 6)
  currency String
  source   String   @default("BROKER")

  @@id([symbol, date])
}

model FxDaily {
  pair String   // e.g. USDKRW
  date DateTime @db.Date
  rate Decimal  @db.Decimal(20, 10)

  @@id([pair, date])
}

/// Value of what a portfolio holds directly, per day, in the user's base currency.
/// Hierarchy roll-ups are computed on read from these rows and the edges.
model Snapshot {
  portfolioId String
  date        DateTime @db.Date
  value       Decimal  @db.Decimal(24, 6)
  flow        Decimal  @db.Decimal(24, 6)
  cash        Decimal  @db.Decimal(24, 6)
  holdings    Json     // { [holdingId]: valueBase }
  createdAt   DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@id([portfolioId, date])
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String
  entity   String
  entityId String
  action   String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
}

enum JournalStatus {
  OPEN
  CLOSED
}

/// A trade journal entry about one asset. The target price is required: price alerts and
/// the AI advisor read it, so it is a typed column rather than part of the free-form body.
model JournalEntry {
  id          String        @id @default(cuid())
  userId      String
  assetId     String
  title       String
  /// The day the entry is about (KST date of the trade or the plan).
  entryDate   DateTime      @db.Date
  status      JournalStatus @default(OPEN)
  /// Prices are in `currency`, the asset's trading currency.
  currency    String
  targetPrice Decimal       @db.Decimal(24, 6)
  /// Price when the entry was written; with the target it gives the direction and progress.
  basePrice   Decimal?      @db.Decimal(24, 6)
  stopPrice   Decimal?      @db.Decimal(24, 6)
  targetDate  DateTime?     @db.Date
  /// Template the entry started from: "builtin:<key>" or a JournalTemplate id. Informational only.
  template    String?
  /// Custom properties with their definitions copied in, so later template edits do not change old entries.
  fields      Json          @default("[]")
  /// BlockNote document (array of blocks).
  content     Json          @default("[]")
  /// Plain text of `content`, for search and for the AI advisor.
  contentText String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset  Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  txns   JournalTxn[]
  alerts PriceAlert[]

  @@index([userId, assetId])
  @@index([userId, entryDate])
}

/// Transactions a journal entry is about.
model JournalTxn {
  entryId       String
  transactionId String

  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  transaction Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@id([entryId, transactionId])
  @@index([transactionId])
}

/// A user's own journal format: custom properties plus a starting body.
model JournalTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  fields      Json     @default("[]")
  content     Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Images pasted or uploaded into journal entries. Served only to their owner.
model JournalImage {
  id        String   @id @default(cuid())
  userId    String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A way of classifying assets, e.g. 올웨더 경제 국면 or 주식 스타일. Its traits are the classes.
model TraitGroup {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  /// Built-in preset it was created from ("allWeather", "equityStyle", ...), if any.
  preset      String?
  /// Trait that portfolio cash balances count as in this group's allocation.
  cashTraitId String?
  /// What shares are measured against: "all" (everything held) or "tagged" (only assets tagged in this group).
  base        String   @default("all")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  traits Trait[]

  @@index([userId])
}

/// One class within a group. `targetWeight` is the wanted share of the group (0..1).
model Trait {
  id           String   @id @default(cuid())
  groupId      String
  name         String
  description  String?
  color        String
  targetWeight Decimal? @db.Decimal(20, 10)
  sortOrder    Int      @default(0)

  group  TraitGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assets AssetTrait[]

  @@unique([groupId, name])
}

/// An asset tagged with a trait. An asset with several traits in one group is split evenly between them.
model AssetTrait {
  assetId String
  traitId String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  trait Trait @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@id([assetId, traitId])
  @@index([traitId])
}

enum AlertDirection {
  ABOVE
  BELOW
}

enum AlertSource {
  MANUAL
  JOURNAL_TARGET
  JOURNAL_STOP
}

/// Fires once when the asset's price reaches `price` in `direction`; re-arm it to use again.
/// Journal entries keep one alert per source in sync with their target and stop prices.
model PriceAlert {
  id             String         @id @default(cuid())
  userId         String
  assetId        String
  journalEntryId String?
  source         AlertSource    @default(MANUAL)
  direction      AlertDirection
  /// In the asset's trading currency
  price          Decimal        @db.Decimal(24, 6)
  currency       String
  note           String?
  active         Boolean        @default(true)
  triggeredAt    DateTime?
  triggeredPrice Decimal?       @db.Decimal(24, 6)
  createdAt      DateTime       @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset   Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  journal JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@unique([journalEntryId, source])
  @@index([active])
  @@index([userId])
}

/// Target weight of one part of a portfolio: a held asset (its id), "CASH", or a child portfolio ("P:<id>").
model PortfolioTarget {
  portfolioId String
  key         String
  weight      Decimal @db.Decimal(20, 10)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@id([portfolioId, key])
}

/// In-app inbox; the same message also goes to the user's push subscriptions.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String
  url       String?
  /// AI advisor conversation that analyzed this alert or holds this briefing
  aiConversationId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A browser or phone that accepted Web Push for this user.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  lastError String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Server-wide settings the app creates for itself (Web Push VAPID keys; secrets encrypted).
model AppSetting {
  key   String @id
  value String
}

/// A quick note. `#키워드` in the body links the note to that topic.
model Note {
  id        String   @id @default(cuid())
  userId    String
  body      String
  pinned    Boolean  @default(false)
  /// Page the note was written on
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

enum BookStatus {
  WANT
  READING
  DONE
}

/// A book and the reader's summary of it.
model Book {
  id            String     @id @default(cuid())
  userId        String
  title         String
  author        String?
  publisher     String?
  publishedYear Int?
  status        BookStatus @default(READING)
  rating        Int?
  startedAt     DateTime?  @db.Date
  finishedAt    DateTime?  @db.Date
  oneLine       String?
  content       Json       @default("[]")
  contentText   String     @default("")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

/// An investor whose philosophy the user keeps notes on.
model Sage {
  id          String   @id @default(cuid())
  userId      String
  name        String
  nameEn      String?
  lived       String?
  affiliation String?
  oneLine     String?
  /// Built-in profile it started from, if any
  preset      String?
  content     Json     @default("[]")
  contentText String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

/// A keyword such as 가치투자 or 안전마진. Linked to traits it implies (가치투자 → 가치주).
model Topic {
  id          String   @id @default(cuid())
  userId      String
  name        String
  color       String   @default("#2a78d6")
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

/// An undirected link between two things the user keeps: note, book, sage, topic, trait, asset.
/// Stored once with the pair in a fixed order (see domain/knowledge.ts).
model KnowledgeLink {
  id        String   @id @default(cuid())
  userId    String
  aType     String
  aId       String
  bType     String
  bId       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, aType, aId, bType, bId])
  @@index([userId, aType, aId])
  @@index([userId, bType, bId])
}

/// A user's key for an outside service other than brokers (카카오 책 검색), AES-256-GCM like
/// broker secrets. `hint` shows the last characters. Without one, the server's env key is used.
model ApiKey {
  userId    String
  service   String
  keyEnc    String
  hint      String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, service])
}

/// AI advisor settings: the user's own Anthropic API key (AES-256-GCM, like broker secrets)
/// and a monthly spending cap. Without a key here the server's ANTHROPIC_API_KEY is used.
model AiSettings {
  userId       String   @id
  apiKeyEnc    String?
  apiKeyHint   String?
  /// Monthly cap in USD, estimated from token usage; null = no cap
  monthlyLimit Decimal? @db.Decimal(10, 2)
  webSearch    Boolean  @default(true)
  /// Morning briefing: on/off, hour (KST), weekdays only, and the KST date of the last one sent
  briefing         Boolean @default(false)
  briefingHour     Int     @default(8)
  briefingWeekdays Boolean @default(true)
  briefingLastDate String?
  /// Have the advisor look into each price / target-weight alert as it arrives
  alertAnalysis    Boolean @default(false)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One chat with an advisor agent. `agent` is MANAGER (포트폴리오 매니저) or SAGE (an investor's lens, sageId).
model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  agent     String
  sageId    String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]
  actions  AiAction[]

  @@index([userId, updatedAt])
}

/// A message exactly as sent to or received from the Messages API, in order (append-only).
model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  seq            Int
  role           String
  content        Json
  model          String?
  usage          Json?
  costUsd        Decimal  @default(0) @db.Decimal(12, 6)
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@index([userId, createdAt])
}

/// Something an agent proposed that changes data (a memo, a price alert, target weights).
/// Runs only when the user presses 실행.
model AiAction {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  toolUseId      String
  kind           String
  payload        Json
  summary        String
  /// PENDING, DONE, DISMISSED, FAILED
  status         String   @default("PENDING")
  result         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

/// A money goal (은퇴 자금, 주택 등): reach `target` by `targetDate` from a portfolio's value
/// (null = net worth) plus monthly saving. Return and volatility override the mix-based assumptions.
model Goal {
  id             String   @id @default(cuid())
  userId         String
  name           String
  target         Decimal  @db.Decimal(24, 2)
  targetDate     DateTime @db.Date
  monthly        Decimal  @default(0) @db.Decimal(24, 2)
  portfolioId    String?
  expectedReturn Decimal? @db.Decimal(8, 5)
  volatility     Decimal? @db.Decimal(8, 5)
  /// Show and compare in today's money (2.5% a year)
  realTerms      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
