# PostgreSQL connection
DATABASE_URL="postgresql://ppfp:ppfp@localhost:5432/ppfp?schema=public"

# 32-byte key, base64. Encrypts each user's brokerage app secrets and access tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Shared secret for the scheduled job endpoints (/api/cron/*). Send as: Authorization: Bearer <value>
CRON_SECRET=""

# Toss Securities OpenAPI base URL. Brokerage credentials are entered per user in the app, not here.
TOSS_API_BASE="https://openapi.tossinvest.com"

# Used when the FX API is unavailable (KRW per 1 USD)
FALLBACK_USDKRW="1390"

# Set to "true" in production behind HTTPS so session cookies are Secure
COOKIE_SECURE="false"

# Alerts. The server checks price alerts every ALERT_POLL_SECONDS (default 60) and portfolio
# target weights every DRIFT_POLL_SECONDS (default 600). ALERTS=off stops the built-in timer;
# then call POST /api/cron/alerts (Bearer CRON_SECRET) from a scheduler instead.
ALERTS=""
ALERT_POLL_SECONDS=""
DRIFT_POLL_SECONDS=""

# Web Push. Leave empty and the server creates a key pair on first use (stored encrypted in the DB).
# Push only works over HTTPS (or http://localhost).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
