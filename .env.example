# PostgreSQL connection
DATABASE_URL="postgresql://ppfp:ppfp@localhost:5432/ppfp?schema=public"

# 32-byte key, base64. Encrypts each user's brokerage app secrets and access tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Shared secret for the scheduled job endpoints (/api/cron/*). Send as: Authorization: Bearer <value>
CRON_SECRET=""

# Toss Securities OpenAPI base URL. Brokerage credentials are entered per user in the app, not here.
TOSS_API_BASE="https://openapi.tossinvest.com"

# Used when the FX API is unavailable (KRW per 1 USD)
FALLBACK_USDKRW="1390"

# Set to "true" in production behind HTTPS so session cookies are Secure
COOKIE_SECURE="false"

# Alerts. The server checks price alerts every ALERT_POLL_SECONDS (default 60) and portfolio
# target weights every DRIFT_POLL_SECONDS (default 600). ALERTS=off stops the built-in timer;
# then call POST /api/cron/alerts (Bearer CRON_SECRET) from a scheduler instead.
ALERTS=""
ALERT_POLL_SECONDS=""
DRIFT_POLL_SECONDS=""
# 부동산 알림 every REALESTATE_POLL_MINUTES (default 180). With ALERTS=off, call
# POST /api/cron/alerts?realestate=1 every few hours instead.
REALESTATE_POLL_MINUTES=""

# Web Push. Leave empty and the server creates a key pair on first use (stored encrypted in the DB).
# Push only works over HTTPS (or http://localhost).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# AI advisor (Claude). Each user can also save their own key in 연동 · 설정; that key wins.
# Without either, the AI advisor stays off.
ANTHROPIC_API_KEY=""

# Book search for 독서 노트 (카카오 책 검색 REST API key). Each user can also save their own in
# 연동 · 설정. Without either, only English titles are found (Open Library, no key needed).
KAKAO_REST_API_KEY=""

# Apartment prices for real estate assets (국토교통부 아파트 매매 실거래가, 공공데이터포털 일반 인증키).
# Each user can also save their own in 연동 · 설정. Finding the apartment uses KAKAO_REST_API_KEY.
DATA_GO_KR_API_KEY=""
# 토지거래허가구역 for 부동산 알림 (브이월드 인증키). Each user can also save their own.
# VWORLD_DOMAIN is sent along when the key was issued for a particular service URL.
VWORLD_API_KEY=""
VWORLD_DOMAIN=""

# Other AI companies for the advisor (each user can also save their own keys in 연동 · 설정 and
# pick a model per agent). Web search is available on Claude models only.
OPENAI_API_KEY=""
GEMINI_API_KEY=""
XAI_API_KEY=""
DEEPSEEK_API_KEY=""

# Account security: who may sign up after the first account — invite (default; codes made
# in 연동 · 설정 › 계정 보안), closed, or open.
SIGNUP_MODE="invite"

# docker compose `backup` service: hours between backups, how many to keep, and an optional
# gpg passphrase that encrypts each file (needed again to restore).
BACKUP_INTERVAL_HOURS="24"
BACKUP_KEEP="14"
BACKUP_GPG_PASSPHRASE=""
